{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    // "types": ["node"]
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  // "include": ["vite.config.ts"]
  "include": ["src"], "exclude": ["node_modules"]
}
